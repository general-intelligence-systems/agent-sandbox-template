#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

CLAIM_MANIFEST="${1:-${REPO_ROOT}/manifests/base/sandbox-claim.yaml}"

echo "Applying SandboxClaim from ${CLAIM_MANIFEST}..."
kubectl apply -f "${CLAIM_MANIFEST}"

CLAIM_NAME="$(kubectl get -f "${CLAIM_MANIFEST}" -o jsonpath='{.metadata.name}')"

echo "Waiting for SandboxClaim '${CLAIM_NAME}' to be ready..."
kubectl wait --for=condition=Ready "sandboxclaim/${CLAIM_NAME}" --timeout=120s

SANDBOX_NAME="$(kubectl get "sandboxclaim/${CLAIM_NAME}" -o jsonpath='{.status.sandbox.Name}')"
SERVICE_FQDN="$(kubectl get "sandbox/${SANDBOX_NAME}" -o jsonpath='{.status.serviceFQDN}' 2>/dev/null || echo "pending")"

echo ""
echo "SandboxClaim '${CLAIM_NAME}' is ready."
echo "  Sandbox:      ${SANDBOX_NAME}"
echo "  Service FQDN: ${SERVICE_FQDN}"
echo ""
echo "To exec into the sandbox:"
echo "  kubectl exec -it \$(kubectl get pod -l agents.x-k8s.io/claim-uid=\$(kubectl get sandboxclaim/${CLAIM_NAME} -o jsonpath='{.metadata.uid}') -o jsonpath='{.items[0].metadata.name}') -- bash"
