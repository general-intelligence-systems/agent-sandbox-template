#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== Step 1/3: Starting k3d cluster ==="
"${SCRIPT_DIR}/start-cluster"
echo ""

echo "=== Step 2/3: Applying manifests ==="
"${SCRIPT_DIR}/apply-manifests"
echo ""

echo "=== Step 3/3: Claiming sandbox ==="
"${SCRIPT_DIR}/claim-sandbox"
echo ""

echo "=== Done! ==="
